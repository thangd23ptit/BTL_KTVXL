ARM GAS  B23DCDT212.Bai3.s 			page 1


   1              	.text
   2              	.global FIND_MAX_VALUES    @ Khai bao nhan de file C co the goi den
   3              	
   4              	FIND_MAX_VALUES:
   5              	@ Y tuong: Duyet mang 1 lan (Linear Scan). O(n)
   6              	@ R0: Chua dia chi bat dau cua mang (arr)
   7              	@ R1: So luong phan tu (512)
   8              	@ R5: Luu Max 1 (Ket qua 1)
   9              	@ R6: Luu Max 2 (Ket qua 2)
  10              	
  11 0000 0050A0E3 	    MOV R5, #0             @ Khoi tao Max 1 = 0
  12 0004 0060A0E3 	    MOV R6, #0             @ Khoi tao Max 2 = 0
  13 0008 0020A0E1 	    MOV R2, R0             @ Sao chep dia chi bat dau vao R2 (con tro i)
  14 000c 01B0A0E1 	    MOV R11, R1            @ Dung R11 lam bien dem so lan lap
  15              	
  16              	LOOP:
  17 0010 00005BE3 	    CMP R11, #0            @ Kiem tra xem da duyet het mang chua
  18 0014 0F00000A 	    BEQ END_FUNC           @ Neu R11 == 0 thi thoat
  19              	    
  20 0018 043092E4 	    LDR R3, [R2], #4       @ Load gia tri arr[i] vao R3 va tang con tro R2 len 4
  21              	    
  22 001c 050053E1 	    CMP R3, R5             @ So sanh gia tri hien tai (R3) voi Max 1 (R5)
  23 0020 0A00009A 	    BLS CHECK_MAX2         @ Neu R3 <= R5, nhay den kiem tra Max 2
  24              	    
  25              	    @ Neu R3 > R5:
  26 0024 0560A0E1 	    MOV R6, R5             @ Max 2 cu = Max 1 cu
  27 0028 0350A0E1 	    MOV R5, R3             @ Max 1 moi = R3
  28 002c 0D0000EA 	    B NEXT_ITER
  29              	
  30              	CHECK_MAX2:
  31 0030 060053E1 	    CMP R3, R6             @ So sanh R3 voi Max 2 (R6)
  32 0034 0D00009A 	    BLS NEXT_ITER          @ Neu R3 <= R6, bo qua
  33 0038 0360A0E1 	    MOV R6, R3             @ Neu R3 > R6, cap nhat Max 2 moi = R3
  34              	
  35              	NEXT_ITER:
  36 003c 01B04BE2 	    SUB R11, R11, #1       @ Giam bien dem
  37 0040 020000EA 	    B LOOP                 @ Quay lai vong lap
  38              	
  39              	END_FUNC:
  40 0044 1EFF2FE1 	    BX LR                  @ Quay ve ham main trong C
